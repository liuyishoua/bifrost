[Unit]
Description=Bifrost website portal
After=network-online.target
Wants=network-online.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/leo-project/bifrost
Environment=BIFROST_PUBLIC_ORIGIN=https://d.58nft.net
Environment=OPS_IDENTITY_URL=http://127.0.0.1:8787
ExecStart=/home/ubuntu/leo-project/bifrost/.venv/bin/python /home/ubuntu/leo-project/bifrost/portal.py
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
